# ──────────────────────────────────────────────
# Brevo – Email & Kontakte
# ──────────────────────────────────────────────

# SMTP-Key (xsmtpsib-...) → Brevo Dashboard > SMTP & API
BREVO_API_KEY=xsmtpsib-your-smtp-key-here

# Brevo SMTP Login → Brevo Dashboard > SMTP & API > Login
BREVO_SMTP_USER=your-smtp-login@smtp-brevo.com

# E-Mail-Adresse, an die Feedback gesendet wird
BREVO_FEEDBACK_RECIPIENT=your@email.com

# Brevo Kontaktlisten-ID für Email-Signup (Standard: 2)
BREVO_LIST_ID=2
