# Formspree Form IDs
# 1. Go to https://formspree.io and create two forms
# 2. Copy the form ID from the endpoint URL (e.g. https://formspree.io/f/YOUR_ID)
# 3. Rename this file to .env.local and fill in your IDs

NEXT_PUBLIC_FORMSPREE_FEEDBACK_ID=your_feedback_form_id_here
NEXT_PUBLIC_FORMSPREE_SIGNUP_ID=your_signup_form_id_here
