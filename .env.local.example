# Brevo (Sendinblue) – für Email-Signup
# API Key aus: https://app.brevo.com/settings/keys/api  (beginnt mit xkeysib-)
BREVO_API_KEY=xkeysib-your-api-key-here

# Brevo Kontaktlisten-ID (Standard: 2)
BREVO_LIST_ID=2

# Formspree – für das Feedback-Formular
# Form-ID aus der URL: https://formspree.io/f/YOUR_ID
NEXT_PUBLIC_FORMSPREE_FEEDBACK_ID=your_feedback_form_id_here
