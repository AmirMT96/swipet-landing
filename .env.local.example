# ──────────────────────────────────────────────
# Brevo – Email & Kontakte
# ──────────────────────────────────────────────

# SMTP-Key (beginnt mit xsmtpsib-) → Brevo Dashboard > SMTP & API > SMTP
BREVO_API_KEY=xsmtpsib-your-smtp-key-here

# Deine Brevo Login-E-Mail (= SMTP Username)
BREVO_SMTP_USER=deine@email.com

# E-Mail-Adresse, an die Feedback gesendet wird
BREVO_FEEDBACK_RECIPIENT=deine@email.com

# Brevo Kontaktlisten-ID für Email-Signup (Standard: 2)
BREVO_LIST_ID=2
